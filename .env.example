# Required for a working deployment (PostgreSQL 14+, e.g. Neon).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heirloom
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set for local development / custom domains. Vercel domains are detected automatically.
BETTER_AUTH_URL=http://localhost:3000
# Create a PRIVATE Vercel Blob store. The public mode is intentionally unsupported.
BLOB_READ_WRITE_TOKEN=

# Optional: users can supply their own key in Settings instead.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional: key encryption uses this secret, falling back to BETTER_AUTH_SECRET.
# Keep stable and back up. Rotation requires re-entering stored API keys.
ENCRYPTION_SECRET=
# Optional email verification, password reset, and weekly prompts (Resend).
RESEND_API_KEY=
EMAIL_FROM=Heirloom <stories@yourdomain.com>
# Needed to enable the scheduled reminder endpoint. Generate a random 32+ character value.
CRON_SECRET=
# Optional SMS reminders, sent only to a storyteller who explicitly opts in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional comma-separated signup allowlist for a private family deployment.
ALLOWED_EMAILS=
